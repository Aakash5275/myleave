# Supabase Postgres. Use the pooler connection for the app (port 6543)
# and the session connection for Prisma migrations (port 5432).
# In Supabase: Project Settings → Database → Connection string.
# URL-encode any special characters in the database password.

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# At least 32 characters. Generate a new value for production.
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Used once, only when the database has no active admin.
INITIAL_ADMIN_EMAIL="hr@yourcompany.com"
INITIAL_ADMIN_NAME="Your Name"
INITIAL_ADMIN_PASSWORD="choose-a-strong-password-1"
